{
  "PATCH /api/v1/issues/{id}": {
    "slate.issues.close": {
      "fields": [
        "closed_by",
        "status"
      ],
      "statuses": [
        "canceled",
        "completed"
      ]
    },
    "slate.records.plan": {
      "fields": [
        "acceptance",
        "initiative",
        "paths",
        "priority"
      ]
    }
  }
}
