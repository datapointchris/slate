{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:slate:tui:documents:v1",
  "title": "The documents that the documents tab of slate tui groups under their records",
  "description": "What `slate tui --view documents --json` prints: every document on the records written to last, within the record bound, each under its record. A record's and a document's fields carry the names and values that `slate documents list --json` gives them. cursor_document is the latest version that the cursor's row opens, with its line comments, under the names `slate documents show --json` gives them. This read writes nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taken_at", "tab", "record_limit", "total_records", "records", "cursor_document", "reads"],
  "properties": {
    "schema_version": {"const": 1},
    "taken_at": {"type": "string", "format": "date-time"},
    "tab": {"const": "documents"},
    "record_limit": {
      "description": "How many records the list read asked for, the records written to last. + and - move it by 50.",
      "type": "integer",
      "minimum": 50,
      "maximum": 500
    },
    "total_records": {
      "description": "How many records hold a document. Where it exceeds record_limit, the rest went unread.",
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "description": "Each record holding a document, the one written to last first.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "documents"],
        "properties": {
          "record": {"$ref": "#/definitions/record"},
          "documents": {
            "description": "The record's documents, the newest written first.",
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/definitions/document"}
          }
        }
      }
    },
    "cursor_document": {
      "description": "The latest version of the document under the cursor, which --json puts on the first. Null before its read lands.",
      "oneOf": [{"type": "null"}, {"$ref": "#/definitions/cursorDocument"}]
    },
    "reads": {
      "description": "Each source the tab reads, as its last read left it: the list, then the cursor's document.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "every"],
        "properties": {
          "name": {"type": "string"},
          "every": {"type": "string"},
          "read_at": {"type": "string", "format": "date-time"},
          "took": {"type": "string"},
          "tried_at": {"type": "string", "format": "date-time"},
          "fault": {"type": "string"},
          "note": {"type": "string"},
          "reading": {"type": "boolean"}
        }
      }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "kind", "title", "status"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["idea", "initiative", "issue", "pursuit"]},
        "title": {"type": "string"},
        "status": {"type": ["string", "null"]}
      }
    },
    "versionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "written_by", "session", "worklog", "written_ts", "flow_id", "line_count"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "written_by": {"type": "string"},
        "session": {"type": ["string", "null"]},
        "worklog": {"type": ["string", "null"]},
        "written_ts": {"type": "string", "format": "date-time"},
        "flow_id": {"type": ["string", "null"]},
        "line_count": {"type": "integer", "minimum": 0}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_number", "name", "address", "kind", "created_ts", "latest", "comment_count"],
      "properties": {
        "record_number": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "address": {"description": "The record's number and the document's name, as 4271/plan.", "type": "string"},
        "kind": {"type": "string"},
        "created_ts": {"type": "string", "format": "date-time"},
        "latest": {"$ref": "#/definitions/versionSummary"},
        "comment_count": {"type": "integer", "minimum": 0}
      }
    },
    "cursorDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "name", "address", "kind", "created_ts", "version", "comments"],
      "properties": {
        "record": {"$ref": "#/definitions/record"},
        "name": {"type": "string"},
        "address": {"type": "string"},
        "kind": {"type": "string"},
        "created_ts": {"type": "string", "format": "date-time"},
        "version": {
          "description": "The latest version: its summary's fields, its body, and the body's lines as `slate comments add --line` numbers them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "written_by", "session", "worklog", "written_ts", "flow_id", "line_count", "body", "lines"],
          "properties": {
            "version": {"type": "integer", "minimum": 1},
            "written_by": {"type": "string"},
            "session": {"type": ["string", "null"]},
            "worklog": {"type": ["string", "null"]},
            "written_ts": {"type": "string", "format": "date-time"},
            "flow_id": {"type": ["string", "null"]},
            "line_count": {"type": "integer", "minimum": 0},
            "body": {"type": "string"},
            "lines": {"type": "array", "items": {"type": "string"}}
          }
        },
        "comments": {
          "description": "Every line comment, oldest first, each placed on the latest version.",
          "type": "array",
          "items": {"$ref": "#/definitions/placedComment"}
        }
      }
    },
    "placedComment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "record_number", "body", "written_by", "session", "worklog", "written_ts", "flow_id", "on", "shown_line"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "record_number": {"type": "integer", "minimum": 1},
        "body": {"type": "string"},
        "written_by": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]},
        "worklog": {"type": ["string", "null"]},
        "written_ts": {"type": "string", "format": "date-time"},
        "flow_id": {"type": ["string", "null"]},
        "on": {
          "description": "The version and line the comment was written on, and the line as it read there.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["document", "kind", "version", "line", "text"],
              "properties": {
                "document": {"type": "string"},
                "kind": {"type": "string"},
                "version": {"type": "integer", "minimum": 1},
                "line": {"type": "integer", "minimum": 1},
                "text": {"type": "string"}
              }
            }
          ]
        },
        "shown_line": {
          "description": "The line of the latest version the comment sits on. Null where that version changed or removed the line.",
          "type": ["integer", "null"]
        }
      }
    }
  }
}
